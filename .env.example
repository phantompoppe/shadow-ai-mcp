# Local demo only. Production defaults to JWT and fails startup without JWT configuration.
SHAI_DATABASE_URL=postgresql+psycopg://shadow:local-only-change-me@db:5432/shadow
SHAI_DEVELOPMENT_MODE=true
SHAI_AUTH_MODE=dev
SHAI_TRANSPORT=streamable-http
SHAI_HOST=0.0.0.0
SHAI_ALLOWED_HOSTS=["localhost:8000","127.0.0.1:8000"]
SHAI_DEV_TRUSTED_CIDRS=["127.0.0.1/32","172.16.0.0/12"]
SHAI_CONNECTORS_FILE=examples/connectors.yaml
SHAI_CATALOG_FILE=examples/provider-catalog.yaml
SHAI_METADATA_ALLOWLIST=["environment"]
SHAI_POLLING_SECONDS=300
SHAI_CORRELATION_SECONDS=120
SHAI_FRESHNESS_SECONDS=900
SHAI_RUN_WORKER=true
# Production example: SHAI_AUTH_MODE=jwt, SHAI_JWT_ISSUER=https://id.example/,
# SHAI_JWT_AUDIENCE=shadow-ai-mcp, SHAI_JWT_JWKS_URL=https://id.example/jwks
# Gateway mode: trusted CIDRs plus SHAI_GATEWAY_ASSERTION_SECRET_ENV (env variable name).
